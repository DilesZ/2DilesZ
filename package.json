{
  "name": "2dilesz-faro-perdido",
  "version": "1.0.0",
  "description": "2DilesZ: El Faro Perdido — plataformas pixel-retro (Phaser 3 + TypeScript + Vite)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "playwright": "^1.63.0",
    "prettier": "^3.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
